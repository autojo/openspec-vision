#!/usr/bin/env bash
# boss -- single control session for OpenSpec apply cycles across projects.
# Subcommands: dispatch, status, review, wait, retrigger, finish, answer,
# inbox, journal, doctor, config-json.

set -u

# Find and source boss-lib.sh without 'readlink -f' (macOS has no -f): walk
# this script's symlink chain, then let the library's resolve_path finalize
# BIN_DIR. BASH_SOURCE[0] may be the ~/.local/bin/boss symlink, not the real
# file, so the library is not next to the invoked path.
BOSS_SELF="${BASH_SOURCE[0]}"
while [ -L "$BOSS_SELF" ]; do
  BOSS_LINK="$(readlink "$BOSS_SELF" 2>/dev/null)" || break
  case "$BOSS_LINK" in
    /*) BOSS_SELF="$BOSS_LINK" ;;
    *) BOSS_SELF="$(dirname "$BOSS_SELF")/$BOSS_LINK" ;;
  esac
done
BOSS_LIB_DIR="$(cd "$(dirname "$BOSS_SELF")" && pwd -P)" || exit 1
# shellcheck source=./boss-lib.sh
. "$BOSS_LIB_DIR/boss-lib.sh"
# shellcheck disable=SC2034  # shared global, read by the library helpers
BIN_DIR="$(dirname "$(resolve_path "${BASH_SOURCE[0]}")")"

# The commands are split by area into modules next to this script. They only
# define functions, so the order does not matter; splitting keeps one file from
# growing past what a review can hold at once.
for _boss_module in apply status review run doctor mission; do
  # shellcheck source=./boss-apply.sh
  . "$BOSS_LIB_DIR/boss-$_boss_module.sh"
done
unset _boss_module
unset BOSS_SELF BOSS_LINK BOSS_LIB_DIR

usage() {
  cat >&2 <<'EOF'
boss -- control session for OpenSpec apply cycles (see README.md)

Usage:
  boss dispatch <change> [--project <name|path>] [--runner <name>] [--note <text>] [--worktree|--no-worktree] [--touches <list|none>] [--as <pane|agent>]
  boss plan commit <change> [--project <name|path>]
  boss status [<change>] [--project <name|path>] [--json]
  boss review <change> [--project <name|path>] [--json]
  boss wait <change> [--project <name|path>]
  boss wait --all [--project <name|path> | --all-projects]
  boss inbox [--project <name|path>] [--json] [--ack <id>]
  boss journal [--project <name|path>] [--change <change>] [--tag <tag>] <text>
  boss doctor [--project <name|path>] [--json] [--fix]
  boss retrigger <change> [--project <name|path>] [--note <text>] [--as <pane|agent>]
  boss retarget <change> [--project <name|path>] [--to <pane|agent>]
  boss finish <change> [--project <name|path>] [--force] [--keep-worktree] [--no-merge] [--lesson <text>] [--lesson-scope project|global] [--as <pane|agent>]
  boss park <change> [--project <name|path>] [--note <text>] [--as <pane|agent>]
  boss resume <change> [--project <name|path>] [--note <text>] [--as <pane|agent>]
  boss interrupt <change> [--project <name|path>] [--as <pane|agent>]
  boss answer <change> <key>... [--project <name|path>] [--as <pane|agent>]
  boss skills dir [--project <name|path>] [--json]
  boss claim [--name <name>] [--release] [--force] [--as <pane|agent>]
  boss session [--project <name|path>] [--runner <name>]
  boss mission start <slug> --project <name|path>
  boss mission status <slug> [--project <name|path>]
  boss mission next <slug> [--project <name|path>] [--dry-run] [--skip-reconcile] [--worktree|--no-worktree] [--as <pane|agent>]
  boss mission add|rm <slug> <change> [--project <name|path>]
  boss reconcile <slug> [--project <name|path>] [--json]
  boss config-json
  boss --version
  boss --help
EOF
  exit 2
}

# ---------------------------------------------------------------- config ---

config_json() {
  local out rc
  [ -f "$BOSS_CONFIG" ] || die_json "config_missing" "config file not found: $BOSS_CONFIG"
  require_cmd python3
  out="$(python3 - "$BOSS_CONFIG" 2>&1 <<'PY'
import sys
try:
    import tomllib
except ModuleNotFoundError:
    sys.exit("python3 >= 3.11 is required to read boss.toml (module tomllib missing)")
import json
with open(sys.argv[1], "rb") as f:
    json.dump(tomllib.load(f), sys.stdout)
PY
)"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    die_json "config_invalid" "cannot parse $BOSS_CONFIG: $out"
  fi
  printf '%s\n' "$out"
}

apply_template_for() {
  case "$1" in
    claude|gemini) printf '/opsx:apply {change}' ;;
    codex) printf '$openspec-apply-change {change}' ;;
    *) printf '/opsx-apply {change}' ;;
  esac
}

# ensure_config -- generate $BOSS_CONFIG from installed agents on first use;
# an existing file is never overwritten.
ensure_config() {
  [ -f "$BOSS_CONFIG" ] && return 0

  local dir
  dir="$(dirname "$BOSS_CONFIG")"
  mkdir -p "$dir" || die_json "config_write" "cannot create config dir: $dir"

  local kinds="claude gemini opencode copilot kilo qwen cursor codex"
  local found="" kind
  for kind in $kinds; do
    if command -v "$kind" >/dev/null 2>&1; then
      found="$found $kind"
    fi
  done
  found="${found# }"

  local header
  header="# Generated by 'boss' on $(date '+%Y-%m-%d %H:%M:%S %Z')."

  if [ -z "$found" ]; then
    if ! {
      printf '%s\n' "$header"
      printf '%s\n' "# No supported agent (claude, gemini, opencode, copilot, kilo, qwen, cursor, codex) was found in PATH."
      printf '%s\n' "# Add a [runners.<name>] entry and set 'default', then run the command again."
    } >"$BOSS_CONFIG"; then
      rm -f "$BOSS_CONFIG"
      die_json "config_write" "cannot write $BOSS_CONFIG; check the directory permissions"
    fi
    die_json "no_agent_found" "no supported agent found in PATH; wrote a template to $BOSS_CONFIG -- add a runner and retry"
  fi

  local default_runner
  case " $found " in
    *" opencode "*) default_runner="opencode" ;;
    *) default_runner="${found%% *}" ;;
  esac

  {
    printf '%s\n' "$header"
    printf '%s\n' "# Edit freely -- boss never overwrites this file."
    printf '%s\n' "# default: runner used when none is given on the command line."
    printf '%s\n' "# [runners.<name>]: kind = agent kind, args = extra agent start arguments,"
    printf '%s\n' "#                  and env = extra environment entries. OpenCode V2 adds"
    printf '%s\n' "#                  '--auto' when args is absent or empty and never sets the"
    printf '%s\n' "#                  V1 OPENCODE_CONFIG_CONTENT default; OpenCode V1 keeps the"
    printf '%s\n' "#                  inline permission default. Explicit args/env always win."
    printf '%s\n' "#                  apply = OpenSpec apply command template ({change} is replaced)."
    printf '%s\n' "#                  The template may carry more than the command: free text is sent"
    printf '%s\n' "#                  to the agent as well, e.g. its commit expectation. Put runner-wide"
    printf '%s\n' "#                  instructions here, not in every --note."
    printf '%s\n' "# [projects]: name -> repo path (absolute or ~), so projects can be addressed by name."
    printf 'default = "%s"\n' "$default_runner"
    for kind in $found; do
      printf '\n[runners.%s]\n' "$kind"
      printf 'kind = "%s"\n' "$kind"
      if [ "$kind" = "claude" ]; then
        printf 'args = ["--permission-mode", "bypassPermissions"]\n'
      else
        printf 'args = []\n'
      fi
      printf '# apply may carry runner-wide instructions after the command, e.g. whether\n'
      printf '# the agent should commit its work: apply = "… Commit when done."\n'
      printf 'apply = "%s"\n' "$(apply_template_for "$kind")"
    done
    printf '\n[projects]\n'
    printf '# shop = "~/work/shop"\n'
    printf '\n[missions]\n'
    printf '# worktrees = "auto"  # auto | always | never; --worktree/--no-worktree override\n'
    printf '# max_parallel = 1     # hard cap on running applies; > 1 forces worktrees\n'
    printf '#                      # BOSS_MAX_PARALLEL overrides it for one process\n'
  } >"$BOSS_CONFIG" || {
    # A redirect failure must not report success: the next command would read a
    # missing or half-written config.
    rm -f "$BOSS_CONFIG"
    die_json "config_write" "cannot write $BOSS_CONFIG; check the directory permissions"
  }
  log "generated config at $BOSS_CONFIG (default runner: $default_runner)"
}

# resolve_runner [<name>] -- print runner JSON {name, kind, args, apply};
# uses the default runner when no name is given.
resolve_runner() {
  local name="${1:-}" cfg
  cfg="$(config_json)" || exit 1
  if [ -z "$name" ]; then
    name="$(printf '%s' "$cfg" | jq -r '.default // empty')"
    [ -n "$name" ] || die_json "no_default_runner" "no default runner configured in $BOSS_CONFIG"
  fi
  local runner configured commit
  runner="$(printf '%s' "$cfg" | jq -c --arg n "$name" '.runners[$n]')"
  if [ "$runner" = "null" ]; then
    configured="$(printf '%s' "$cfg" | jq -r '(.runners // {}) | keys | join(", ") | if . == "" then "(none)" else . end')"
    die_json "unknown_runner" "unknown runner '$name'; configured runners: $configured"
  fi
  commit="$(printf '%s' "$runner" | jq -r '.commit // "explorer"')"
  case "$commit" in
    explorer|agent) ;;
    *) die_json "invalid_runner_commit" "runner '$name' has invalid commit policy '$commit'; use 'explorer' or 'agent'" ;;
  esac
  printf '%s\n' "$runner" | jq -c --arg n "$name" --arg c "$commit" '. + {name: $n, commit: $c}'
}

# runner_yield_of <runner-json> -- the yield instruction sent to the apply
# agent: the runner's own text, or the built-in default when the field is
# absent. An empty string disables the instruction.
runner_yield_of() {
  printf '%s' "$1" | jq -r --arg d "$BOSS_APPLY_YIELD_DEFAULT" \
    'if has("yield") then .yield else $d end'
}

# runner_commit_block <runner-json> -- fixed commit instruction for the apply
# prompt. The default policy is 'explorer': only the Explorer commits.
lessons_global_path() {
  local cfg path
  if [ -n "${BOSS_LESSONS_GLOBAL:-}" ]; then
    expand_home "$BOSS_LESSONS_GLOBAL"
    return 0
  fi
  cfg="$(config_json)" || return 1
  path="$(printf '%s' "$cfg" | jq -r '.lessons.global // empty')"
  # shellcheck disable=SC2088  # the tilde is expanded by expand_home
  [ -n "$path" ] || path="~/.config/openspec-boss/lessons.md"
  expand_home "$path"
}

# lessons_project_path <project> -- path of the project's lessons store:
# '[lessons] project' relative to the project root, or the default
# openspec/lessons.md. An absolute or ~ path is used as is.
lessons_project_path() {
  local project="$1" cfg path
  cfg="$(config_json)" || return 1
  path="$(printf '%s' "$cfg" | jq -r '.lessons.project // empty')"
  [ -n "$path" ] || path="openspec/lessons.md"
  # shellcheck disable=SC2088  # a literal tilde, expanded by expand_home
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    "~"|"~/"*) expand_home "$path" ;;
    *) printf '%s/%s\n' "$project" "$path" ;;
  esac
}

# journal_project_path <project> -- path of the project's decision journal:
# '[journal] project' relative to the project root, or the default
# openspec/journal.md. An absolute or ~ path is used as is.
journal_project_path() {
  local project="$1" cfg path
  cfg="$(config_json)" || return 1
  path="$(printf '%s' "$cfg" | jq -r '.journal.project // empty')"
  [ -n "$path" ] || path="openspec/journal.md"
  # shellcheck disable=SC2088  # a literal tilde, expanded by expand_home
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    "~"|"~/"*) expand_home "$path" ;;
    *) printf '%s/%s\n' "$project" "$path" ;;
  esac
}

# lessons_prompt_block <global-file> <project-file> -- the "known lessons"
# block for the apply prompt: global lessons first, then project lessons,
# capped at BOSS_LESSONS_MAX rules and BOSS_LESSONS_MAX_CHARS characters.
# Prints nothing when neither store yields an active lesson; an unreadable
# store is logged and skipped.
lessons_prompt_block() {
  local gfile="$1" pfile="$2"
  local max="${BOSS_LESSONS_MAX:-20}" maxchars="${BOSS_LESSONS_MAX_CHARS:-2000}"
  local -a lines=()
  local out rc l header len n
  out="$(lessons_read_active "$gfile")"; rc=$?
  [ "$rc" -eq 0 ] || log "warning: cannot read lessons file $gfile"
  while IFS= read -r l; do [ -n "$l" ] && lines+=("$l"); done <<<"$out"
  out="$(lessons_read_active "$pfile")"; rc=$?
  [ "$rc" -eq 0 ] || log "warning: cannot read lessons file $pfile"
  while IFS= read -r l; do [ -n "$l" ] && lines+=("$l"); done <<<"$out"
  [ "${#lines[@]}" -gt 0 ] || return 0

  header="Verified lessons from earlier runs:"
  len="${#header}"
  n=0
  out="$header"
  for l in "${lines[@]}"; do
    [ "$n" -lt "$max" ] || break
    [ $(( len + ${#l} + 1 )) -le "$maxchars" ] || break
    out="$out"$'\n'"$l"
    len=$(( len + ${#l} + 1 ))
    n=$(( n + 1 ))
  done
  [ "$n" -gt 0 ] || return 0
  printf '%s' "$out"
}

# lessons_active_json <file> -- the active lessons of a store as a JSON array
# (empty when the store is missing or unreadable, which is logged).
lessons_active_json() {
  local file="$1" out rc
  out="$(lessons_read_active "$file")"; rc=$?
  [ "$rc" -eq 0 ] || log "warning: cannot read lessons file $file"
  printf '%s' "$out" | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# find_openspec_root <dir> -- nearest ancestor containing openspec/, or empty
find_openspec_root() {
  local dir="$1"
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -d "$dir/openspec" ]; then
      printf '%s' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# resolve_project [<name|path>] -- print the absolute project path.
# Registry name, existing directory, or upward search from $PWD.
resolve_project() {
  local name="${1:-}" cfg project
  cfg="$(config_json)" || exit 1
  if [ -z "$name" ]; then
    project="$(find_openspec_root "$PWD")"
    if [ -z "$project" ]; then
      die_json "project_unknown" "cannot derive a project from $PWD (no openspec/ found upwards)"
    fi
  else
    project="$(printf '%s' "$cfg" | jq -r --arg n "$name" '.projects[$n] // empty')"
    if [ -z "$project" ]; then
      if [ -d "$(expand_home "$name")" ]; then
        project="$name"
      else
        local registered
        registered="$(printf '%s' "$cfg" | jq -r '(.projects // {}) | keys | join(", ") | if . == "" then "(none)" else . end')"
        die_json "project_unknown" "unknown project '$name'; registered projects: $registered"
      fi
    fi
  fi
  local given="$project"
  project="$(canonical_path "$project")"
  if [ ! -d "$project/openspec/changes" ]; then
    if [ -n "$name" ] && [ "$given" != "$name" ]; then
      die_json "project_invalid" "project '$name' -> '$given' -> '$project' is not an OpenSpec project (missing openspec/changes)"
    fi
    die_json "project_invalid" "'$given' -> '$project' is not an OpenSpec project (missing openspec/changes)"
  fi
  printf '%s\n' "$project"
}

# ------------------------------------------------------- worktree settings ---

# mission_worktree_mode -- the configured worktree mode: auto, always or never.
# An invalid value is a config error, not a silent fallback.
main() {
  require_cmd jq
  case "${1:-}" in
    config-json) shift; config_json "$@" ;;
    dispatch) shift; cmd_dispatch "$@" ;;
    plan) shift; cmd_plan "$@" ;;
    status) shift; cmd_status "$@" ;;
    review) shift; cmd_review "$@" ;;
    wait) shift; cmd_wait "$@" ;;
    inbox) shift; cmd_inbox "$@" ;;
    journal) shift; cmd_journal "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    retrigger) shift; cmd_retrigger "$@" ;;
    retarget) shift; cmd_retarget "$@" ;;
    finish) shift; cmd_finish "$@" ;;
    park) shift; cmd_park "$@" ;;
    resume) shift; cmd_resume "$@" ;;
    interrupt) shift; cmd_interrupt "$@" ;;
    answer) shift; cmd_answer "$@" ;;
    skills) shift; cmd_skills "$@" ;;
    claim) shift; cmd_claim "$@" ;;
    session) shift; cmd_session "$@" ;;
    mission) shift; cmd_mission "$@" ;;
    reconcile) shift; cmd_reconcile "$@" ;;
    -v|--version) boss_version_line ;;
    -h|--help) usage ;;
    "") usage ;;
    *) usage_error "unknown command: ${1:-}" ;;
  esac
}

main "$@"
